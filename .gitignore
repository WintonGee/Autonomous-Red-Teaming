# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local databases
*.db
*.sqlite
*.sqlite3

# Sensitive run output (treat as sensitive per README)
# Keep the evidence/ dir + its README, but never commit captured evidence.
evidence/*
!evidence/.gitkeep
!evidence/README.md
findings/
reports/
logs/

# Unreviewed skill drafts (keep the dir, not its contents)
skills/_drafts/*
!skills/_drafts/.gitkeep

# Autonomously-generated skill specs (grown at runtime; keep the dir only)
skills/_generated/*
!skills/_generated/.gitkeep

# Measurement run artifacts (reproducible; keep the dir + README only)
measurements/*
!measurements/.gitkeep
!measurements/README.md
